{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "warframe-weapons",
  "mainBinaryName": "warframe-weapons",
  "version": "1.0.0",
  "identifier": "management.needs.ephreal.warframe-weapons",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Lich/Sister Weapon Tracker",
        "width": 1120,
        "height": 740
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "shell": {
      "open": true
    }
  }
}
